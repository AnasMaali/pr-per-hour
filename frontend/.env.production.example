# Production frontend build placeholders only — copy to .env.production locally.
# Never commit real domains, tokens, or secrets.
# Rebuild the React app after changing any VITE_* variable.

VITE_API_BASE_URL=https://api.example.com/api/v1

# Cloudflare Turnstile — public site key only (never the secret key).
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=

# Keep aligned with backend FEATURE_* flags. Only "true" enables a module.
VITE_FEATURE_BOOKINGS_ENABLED=false
VITE_FEATURE_CHATBOT_ENABLED=false
VITE_FEATURE_PAYMENTS_ENABLED=false
VITE_FEATURE_INVOICES_ENABLED=false
