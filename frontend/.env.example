# Laravel API base URL (versioned). No secrets. No auth tokens.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Cloudflare Turnstile — public site key only (official always-pass test key for local).
# Only the exact value "true" enables Turnstile; keep aligned with backend TURNSTILE_ENABLED.
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Version 1 feature switches. Future modules remain hidden and unreachable.
# Only the exact value "true" enables a flag; anything else is treated as false.
VITE_FEATURE_BOOKINGS_ENABLED=false
VITE_FEATURE_CHATBOT_ENABLED=false
VITE_FEATURE_PAYMENTS_ENABLED=false
VITE_FEATURE_INVOICES_ENABLED=false
