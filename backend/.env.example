APP_NAME="PR Per Hour"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

CONTACT_INQUIRY_TO_ADDRESS=info@prperhour.com
CONTACT_INQUIRY_TO_NAME="PR Per Hour"


# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (local: official always-pass test keys)
# Secret stays server-side only. Never put TURNSTILE_SECRET_KEY in frontend.
# ---------------------------------------------------------------------------
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1,192.168.1.5
TURNSTILE_TIMEOUT_SECONDS=8

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# API localization (foundation)
# ---------------------------------------------------------------------------
API_LOCALE_HEADER=X-Locale
API_ACCEPT_LANGUAGE_ENABLED=true

# ---------------------------------------------------------------------------
# CORS — comma-separated origins for the React Vite frontend
# Trimmed; empty entries and * are rejected. Do not use *.
# Auth uses Sanctum Bearer tokens (not cookie SPA sessions).
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sanctum stateful domains (optional; Bearer API does not require cookie SPA auth)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# ---------------------------------------------------------------------------
# Named rate limiters (requests per minute) — tune for production
# ---------------------------------------------------------------------------
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_CONTACT=5
RATE_LIMIT_CHATBOT=20
RATE_LIMIT_AUTH_EMAIL_VERIFICATION_CODE=5
RATE_LIMIT_AUTH_EMAIL_VERIFY=10
RATE_LIMIT_AUTH_PASSWORD_FORGOT=5
RATE_LIMIT_AUTH_PASSWORD_RESET=10

# ---------------------------------------------------------------------------
# One-time email codes (verification + password reset)
# ---------------------------------------------------------------------------
OTP_CODE_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_PRUNE_AFTER_DAYS=7

# ---------------------------------------------------------------------------
# Admin seeder (required only when running AdminUserSeeder / full DatabaseSeeder with admin)
# ---------------------------------------------------------------------------
PR_ADMIN_NAME="PR Per Hour Admin"
PR_ADMIN_EMAIL=admin@example.com
PR_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Version 1 feature switches — future modules stay disabled until released
# Safe parsing: false / 0 / off / no never become true (unlike PHP (bool) cast).
# Keep aligned with frontend VITE_FEATURE_* flags.
# ---------------------------------------------------------------------------
FEATURE_BOOKINGS_ENABLED=false
FEATURE_CHATBOT_ENABLED=false
FEATURE_PAYMENTS_ENABLED=false
FEATURE_INVOICES_ENABLED=false

# Bearer token lifetime in minutes (8 hours by default)
SANCTUM_TOKEN_EXPIRATION=480
