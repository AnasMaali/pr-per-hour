# Production API placeholders only — copy to .env.production on the server.
# Never commit real secrets, passwords, tokens, or live domains.
# See docs/PRODUCTION_CONFIGURATION.md

APP_NAME="PR Per Hour"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# Replace with production MySQL (or approved) credentials — never commit real values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pr_per_hour
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile — production placeholders only (never commit real secrets)
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=www.example.com,example.com
TURNSTILE_TIMEOUT_SECONDS=8

# Comma-separated SPA origins only. Never use *.
CORS_ALLOWED_ORIGINS=https://www.example.com

# Optional; Bearer tokens do not require stateful SPA cookies for this API.
SANCTUM_STATEFUL_DOMAINS=www.example.com
SANCTUM_TOKEN_EXPIRATION=480

RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_CONTACT=5
RATE_LIMIT_CHATBOT=20
RATE_LIMIT_AUTH_EMAIL_VERIFICATION_CODE=5
RATE_LIMIT_AUTH_EMAIL_VERIFY=10
RATE_LIMIT_AUTH_PASSWORD_FORGOT=5
RATE_LIMIT_AUTH_PASSWORD_RESET=10

# One-time email codes
OTP_CODE_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_PRUNE_AFTER_DAYS=7

# Admin seeder — set only when seeding; leave empty in running production if unused.
PR_ADMIN_NAME=
PR_ADMIN_EMAIL=
PR_ADMIN_PASSWORD=

# Future modules must stay disabled for Version 1.
# Safe parsing: false / 0 / off / no never become true.
FEATURE_BOOKINGS_ENABLED=false
FEATURE_CHATBOT_ENABLED=false
FEATURE_PAYMENTS_ENABLED=false
FEATURE_INVOICES_ENABLED=false


CONTACT_INQUIRY_TO_ADDRESS=info@prperhour.com
CONTACT_INQUIRY_TO_NAME="PR Per Hour"

# -----------------------------------------------------------------------------
# Version 2 Feature Flags
# -----------------------------------------------------------------------------
# V2 is disabled by default. Enable modules only after approval and testing.

V2_ENABLED=false
V2_PAYMENTS_ENABLED=false
V2_INVOICES_ENABLED=false
V2_CONSULTANTS_ENABLED=false
V2_ADVANCED_SCHEDULING_ENABLED=false
V2_ROLES_PERMISSIONS_ENABLED=false
V2_CRM_ENABLED=false
V2_LEADS_ENABLED=false
V2_COUPONS_ENABLED=false
V2_ADVANCED_CHATBOT_ENABLED=false
V2_KNOWLEDGE_BASE_ENABLED=false
V2_ANALYTICS_ENABLED=false
V2_CMS_ENABLED=false
V2_BLOG_ENABLED=false
V2_NOTIFICATIONS_ENABLED=false

# V2 Booking Scheduling
V2_BOOKING_CALENDAR_MODE=shared
V2_BOOKING_DEFAULT_CALENDAR_SLUG=pr-per-hour-shared
V2_BOOKING_DEFAULT_CALENDAR_TIMEZONE=Asia/Hebron
V2_BOOKING_SLOT_STEP_MINUTES=30
